# Discord bot token (Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=

# Optional: official CoC developer key (only needed if COC_API_BASE is api.clashofclans.com)
COC_API_KEY=

# Default uses ClashKing-compatible proxy (no key). Switch to official if you have a key:
# COC_API_BASE=https://api.clashofclans.com/v1
COC_API_BASE=https://proxy.clashk.ing/v1

# Nepali Legend's
GUILD_ID=1553269087864356884
CLAN_TAG=#R2J28R8Q

# Channels (leave empty to auto-resolve / create by name)
LEGEND_CHANNEL_ID=1553983640537665606
ELECTRO_CHANNEL_ID=1554024392491532361

# Poll interval seconds (90 = lighter on CPU/API)
POLL_INTERVAL=90

# SQLite folder — use /data in Docker/Railway
# DATA_DIR=/data
